PORT=5000
NODE_ENV=development
JWT_SECRET=change_me_to_a_long_random_secret_in_production
DB_PATH=./data/virar_organics.sqlite

# Optional: Stripe TEST mode keys (if omitted, built-in Test Payment Gateway simulator is used)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Secret used by the built-in Test Payment Gateway webhook simulator
PAYMENT_WEBHOOK_SECRET=virar_test_webhook_secret_2026

# Frontend URL for redirects (used in Stripe Checkout)
APP_URL=http://localhost:5173
